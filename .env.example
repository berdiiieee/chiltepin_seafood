# Copia este archivo a .env y ajusta el valor antes de "vite build"
# URL del backend (sin "/" al final)
VITE_API_URL=https://backend-chiltepin.onrender.com

# Pedidos a domicilio propios: off (por defecto) | demo (simulado, para revisar) | on (backend real)
VITE_PEDIDOS=off
# Llaves PÚBLICAS (se ven en el navegador). Restringe la de Google a tu dominio.
VITE_GOOGLE_MAPS_KEY=
VITE_TURNSTILE_SITE_KEY=
